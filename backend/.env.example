PORT=4000
WHATSGPS_USE_MOCK=true

# Auth modes: bearer | login | none
WHATSGPS_AUTH_MODE=bearer

# Base API config
WHATSGPS_API_BASE_URL=https://api.whatsgps.com
WHATSGPS_API_PATH=/api/locations

# For bearer mode
WHATSGPS_API_TOKEN=replace-with-your-token

# For login mode
WHATSGPS_LOGIN_PATH=/api/login
WHATSGPS_USERNAME=replace-with-username
WHATSGPS_PASSWORD=replace-with-password
